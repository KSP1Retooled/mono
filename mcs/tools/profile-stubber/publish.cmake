mono_profile_dir(_raw unityjit)
mono_profile_dir(_bootstrap build)
_mono_tool_command(_stubber unityjit profile-stubber.exe)
_mono_tool_env(_env unityjit)
set(_stubdir "${CMAKE_CURRENT_SOURCE_DIR}/tools/profile-stubber")
get_property(_count GLOBAL PROPERTY MONO_MANAGED_COUNT)
math(EXPR _last "${_count} - 1")
set(_outputs "")
foreach(_i RANGE ${_last})
  set(_decl "MONO_MANAGED_${_i}")
  get_property(_profiles GLOBAL PROPERTY ${_decl}_PROFILES)
  if(NOT unityjit IN_LIST _profiles)
    continue()
  endif()
  get_property(_name GLOBAL PROPERTY ${_decl}_NAME)
  get_property(_subdir GLOBAL PROPERTY ${_decl}_SUBDIR)
  _mono_target_name(_target unityjit "${_subdir}" "${_name}")
  get_property(_input GLOBAL PROPERTY MONO_MANAGED_OUTPUT_${_target})
  if(NOT _input MATCHES "\\.dll$")
    continue()
  endif()

  file(RELATIVE_PATH _rel "${_raw}" "${_input}")
  set(_output "${_unity_player}/${_rel}")
  cmake_path(GET _output PARENT_PATH _dir)
  cmake_path(GET _input FILENAME _filename)
  cmake_path(REPLACE_EXTENSION _input LAST_ONLY ".pdb" OUTPUT_VARIABLE _pdb)
  cmake_path(REPLACE_EXTENSION _output LAST_ONLY ".pdb" OUTPUT_VARIABLE _player_pdb)
  set(_contract "${_stubdir}/unity-6000.7-win32/${_rel}.contract")
  set(_reference "${CMAKE_SOURCE_DIR}/external/binary-reference-assemblies/v4.8/${_rel}")
  get_property(_no_debug GLOBAL PROPERTY ${_decl}_NO_DEBUG)
  set(_products "${_output}")
  if(NOT _no_debug)
    list(APPEND _products "${_player_pdb}")
  endif()
  set(_deps "")
  if(EXISTS "${_contract}")
    list(APPEND _deps "${_contract}" "${_reference}" "${_bootstrap}/profile-stubber.exe" "${_bootstrap}/Mono.Cecil.dll")
    set(_stage "${CMAKE_CURRENT_BINARY_DIR}/profile-stubber/${_rel}.tmp")
    set(_publish
      COMMAND "${CMAKE_COMMAND}" -E make_directory "${_stage}"
      COMMAND "${CMAKE_COMMAND}" -E env ${_env} ${_stubber} "${_reference}" "${_input}" "${_stage}/${_filename}" "${_contract}")
    if(NOT _no_debug)
      cmake_path(GET _pdb FILENAME _symbol_name)
      list(APPEND _publish COMMAND "${CMAKE_COMMAND}" -E rename "${_stage}/${_symbol_name}" "${_player_pdb}")
    endif()
    list(APPEND _publish COMMAND "${CMAKE_COMMAND}" -E rename "${_stage}/${_filename}" "${_output}")
  else()
    set(_publish COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_input}" "${_output}")
    if(NOT _no_debug)
      list(APPEND _publish COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_pdb}" "${_player_pdb}")
    endif()
  endif()
  get_property(_src GLOBAL PROPERTY ${_decl}_DIR)
  if(EXISTS "${_src}/${_filename}.config" OR EXISTS "${_src}/${_filename}.config.unityjit")
    list(APPEND _products "${_output}.config")
    list(APPEND _deps "${_input}.config")
    list(APPEND _publish COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_input}.config" "${_output}.config")
  endif()
  add_custom_command(
    OUTPUT ${_products}
    COMMAND "${CMAKE_COMMAND}" -E make_directory "${_dir}"
    ${_publish}
    DEPENDS "${_input}" ${_deps} ${_target}
    COMMENT "PUBLISH [unityjit] ${_rel}"
    VERBATIM)
  set_property(GLOBAL PROPERTY MONO_MANAGED_OUTPUT_${_target} "${_output}")
  list(APPEND _outputs ${_products})
endforeach()
add_custom_target(mcs-unityjit-player DEPENDS ${_outputs})
add_dependencies(mcs-unityjit mcs-unityjit-player)
install(DIRECTORY "${_unity_player}/" DESTINATION "${CMAKE_INSTALL_LIBDIR}/mono/unityjit-win32"
        COMPONENT mcs FILES_MATCHING PATTERN "*.dll" PATTERN "*.pdb" PATTERN "*.config")
